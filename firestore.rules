rules_version = '2';

// NOTE: Cloud Functions use the Admin SDK, which BYPASSES these rules.
// Never add `request.auth == null` clauses "for Cloud Functions" — that
// grants access to unauthenticated internet clients, not to the backend.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Client clock may drift; accept timestamps within ±10 minutes of server time.
    function isRecentMillis(t) {
      return t is int
        && t > request.time.toMillis() - 600000
        && t < request.time.toMillis() + 600000;
    }

    // ---------------- analyses ----------------
    // Created by the app as PENDING; only the Cloud Function (Admin SDK)
    // may move it to PROCESSING / COMPLETED / FAILED and write results.
    match /analyses/{analysisId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'id', 'userId', 'imageUrl', 'plantType', 'confidence',
             'recommendations', 'timestamp', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == analysisId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() < 2048
        // Image must live in this user's own Storage folder.
        && request.resource.data.imageUrl.matches(
             '^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/images%2F'
             + request.auth.uid + '%2F.*')
        && request.resource.data.plantType == null
        && request.resource.data.confidence == 0
        && request.resource.data.recommendations.size() == 0
        && isRecentMillis(request.resource.data.timestamp);

      // Clients may never modify results.
      allow update: if false;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['phoneNumber', 'name', 'createdAt', 'lastLogin'])
        // Phone number must be the verified one from Firebase Auth.
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && (request.resource.data.name == null
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 100))
        && request.resource.data.createdAt is int
        && request.resource.data.lastLogin is int;
    }

    // ---------------- reference data (read-only) ----------------
    // Managed by admins / Cloud Functions via the Admin SDK only.
    match /crops/{cropId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /diseases/{diseaseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /treatments/{treatmentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Everything else is denied by default.
  }
}
