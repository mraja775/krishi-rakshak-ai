rules_version = '2';

// NOTE: Cloud Functions use the Admin SDK, which BYPASSES these rules.
// Never add `request.auth == null` clauses — that opens the bucket to the public.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Uploaded plant photos: images/{userId}/{filename}
    match /images/{userId}/{filename} {
      allow read: if isOwner(userId);

      // Upload: images only, max 5 MB, no overwriting existing files.
      allow create: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && filename.matches('[A-Za-z0-9_.-]{1,200}');

      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // Written only by Cloud Functions (Admin SDK).
    match /analysis-results/{userId}/{filename} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // App assets, managed by admins.
    match /public/{filename} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else is denied by default.
  }
}
