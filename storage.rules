rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Images folder
    match /images/{userId}/{filename} {
      // Users can upload images to their own folder
      allow write: if request.auth != null &&
                      request.auth.uid == userId;

      // Users can read their own images
      allow read: if request.auth != null &&
                     request.auth.uid == userId;
    }

    // Analysis results folder (for Cloud Functions)
    match /analysis-results/{userId}/{filename} {
      // Users can read their own analysis results
      allow read: if request.auth != null &&
                     request.auth.uid == userId;

      // Cloud Functions can write analysis results
      allow write: if request.auth == null;
    }

    // Public assets folder (for app resources)
    match /public/{filename} {
      // All authenticated users can read public assets
      allow read: if request.auth != null;
      
      // Only Cloud Functions can write public assets
      allow write: if request.auth == null;
    }
  }
}

