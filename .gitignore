.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Node modules (for Firebase functions)
functions/node_modules/
functions/.env

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Version control
vcs.xml

